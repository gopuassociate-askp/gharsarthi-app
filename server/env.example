# Copy to .env on the server (never commit .env).
# The domain must point to this server's IP address (an A record) before starting.
DOMAIN=app.example.in
# Pin the n8n version: use the same one n8n Cloud shows (Help > About n8n) so the
# workflows import unchanged. Upgrade deliberately, after a backup.
N8N_VERSION=
# Generate each with:  openssl rand -hex 32
POSTGRES_PASSWORD=change-me
N8N_ENCRYPTION_KEY=change-me
